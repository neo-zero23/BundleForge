#!/bin/sh
# bf-selftest: integrity probe for BundleForge test packages (Linux).
# After installing the package, run it from its payload dir, e.g.:
#   /usr/share/demo-selftest/bf-selftest
VERSION="1.0"
HERE="$(dirname "$0")"
pass=0
fail=0
ok() { echo "PASS: $1"; pass=$((pass + 1)); }
bad() { echo "FAIL: $1"; fail=$((fail + 1)); }

echo "bf-selftest $VERSION on $(uname -s -m)"
ok "runs at all"

if [ -f "$HERE/hello.txt" ]; then
    ok "payload hello.txt present"
else
    bad "payload hello.txt missing"
fi

if [ -x "$0" ]; then
    ok "executable bit kept"
else
    bad "executable bit lost in packaging"
fi

if grep -q "hello-from-bundleforge" "$HERE/hello.txt" 2>/dev/null; then
    ok "payload content intact"
else
    bad "payload content changed"
fi

echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
